<?xml version="1.0" encoding="UTF-8"?>
<opml version="2.0" xmlns:porridge="https://github.com/alexjj/porridge">
  <head>
    <title>About</title>
    <porridge:inNav>true</porridge:inNav>
    <porridge:navOrder>1</porridge:navOrder>
  </head>
  <body>
    <outline text="A few words about you and this blog. Pages are outlines too: a line on its own is a paragraph."/>
    <outline text="Elsewhere" list="bullets">
      <outline text="[GitHub](https://github.com/)"/>
      <outline text="[Mastodon](https://joinmastodon.org/)"/>
    </outline>
    <outline text="This page">
      <outline text="A line with lines under it becomes a heading, like the ones above. To show the lines under a heading as bullets, like *Elsewhere*, choose **Children as bullets** in its bullet menu."/>
      <outline text="It's in the site's navigation because of its settings: click the cog beside the page's title in the editor to change that, rename it, or make it a draft."/>
    </outline>
  </body>
</opml>
